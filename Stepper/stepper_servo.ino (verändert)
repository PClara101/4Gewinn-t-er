#include "stepper001.h" // einbinden der Stepper-Klasse
#include <Servo.h>;  // einbinden der Servo-Bibliothek, um Servomotor zu steuern

// Pins Stepper
#define ENABLE_PIN 4  // wenn HIGH, Stepper aus
#define STEP_PIN 2    // gibt Stepper Schritt-Signal
#define DIR_PIN 3     // Drehrichtung (high=richtung trichter, low=richtung parkplatz)

// Pin Servo
#define SERVO 7

int col;

stepper stepper(ENABLE_PIN, STEP_PIN, DIR_PIN);  // erstellt Objekt der stepper-Klasse mit den Pins
Servo servo;  // erstellt Servo-Objekt

void setup() {
  Serial.begin(9600);
  servo.attach(SERVO);  // bindet Servo an Pin 7
  delay(500);  // Warten, damit der Servo sich initialisiert

  randomSeed(analogRead(2));  // zufällige Spalte auswählen
  col = random(1,8);
  Serial.println(col);

  stepper.moveTo(col);  // Stepper bewegt sich zur Position col
  delay(100);
  push();  // Servo bewegt sich
  delay(100); 
  stepper.moveTo(0); // Stepper fährt zurück zum Parkplatz
}

// Funktion bewegt Servo hin und zurück:
void push() {
  Serial.println("Servo dreht sich hin");  // Ausgabe zur Kontrolle
  // Servo dreht sich von 160° auf 25°:
  for (int i = 160; i>=25; i--) {
    servo.write(i);
    delay(30);
  }
  Serial.println("Servo dreht sich zurück");  // Ausgabe zur Kontrolle
  // Servo dreht sich zurück von 25° auf 160°:
  for (int i = 25; i <= 160; i++) {
    servo.write(i);
    delay(30);
  }
}

